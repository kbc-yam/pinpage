{
  "id": "./index2.html",
  "name": "Secure Home",
  "short_name": "Secure Home",
  "description": "iPhoneスタイルのセキュアホーム画面",
  "lang": "ja",
  "start_url": "./index2.html",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "portrait",
  "background_color": "#12090e",
